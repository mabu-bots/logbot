# logbot の環境変数の見本。コピーして .env を作り、値を入れること。
# 実トークンをリポジトリに含めないこと。

# Discord のトークン（必須。この Bot 専用のアプリケーションを使うこと。
# p1228 のものは使い回さない）
DISCORD_TOKEN=
# Discord アプリケーション ID（必須。コマンド同期・削除に使う）
DISCORD_APPLICATION_ID=
# SQLite データの保存先（任意。既定は ./data で、data/logbot.db に保存される）
DATA_DIR=./data
# ログレベル（任意。既定 info）
LOG_LEVEL=info
# プレゼンスのカスタム文言（任意。既定は「ログを見守り中」。
# /watching set で保存した文言があればそちらが優先される）
WATCHING_TEXT=ログを見守り中
